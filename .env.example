# Server-side only. Never prefix these with VITE_ and never commit real values.

# Sessions (Sign-In with Ethereum). 32+ random characters.
SESSION_SECRET=

# Postgres (Supabase). Direct Postgres connection only: no Supabase API keys are used by this app.
# Use the Supavisor "Transaction pooler" connection string (port 6543) for Vercel serverless.
# Apply server/db/schema.sql first (it enables row level security on every table).
DATABASE_URL=
# Optional but recommended: Supabase's server CA certificate (PEM) to pin. \n escapes are accepted.
# Without it, TLS is still required and the certificate is verified against Node's public CA store
# (sslmode=require in the URL is accepted and means verified TLS; weaker modes are refused).
DATABASE_CA_CERT=
# Only for a local database without TLS. Never set in Vercel.
DATABASE_SSL=

# Payments stay off unless this is exactly "true" AND every cap below is set (uUSDC, 6 decimals).
# The database kill switch (system_flags.payments_kill_switch) also starts ON.
PAYMENTS_ENABLED=false
CAP_PER_REQUEST_UUSDC=
CAP_PER_USER_DAILY_UUSDC=
CAP_GLOBAL_DAILY_UUSDC=
CAP_GLOBAL_TOTAL_UUSDC=

# Provider allowlist: fill ONLY from live-verified discovery. See config/provider-allowlist.example.json.
PROVIDER_ALLOWLIST_JSON=
PROVIDER_ALLOWLIST_PATH=

# DefiLlama paid yields API. Without both, the proxy uses the legacy free endpoint (shuts down 13 Nov 2026).
# The template must contain {key}; confirm the exact base URL against DefiLlama's docs before setting it.
DEFILLAMA_API_KEY=
DEFILLAMA_YIELDS_BASE_TEMPLATE=
